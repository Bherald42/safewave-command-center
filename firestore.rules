rules_version = '2';
// Safewave Command Center — Firestore security rules.
// Paste these into: Firebase console → Build → Firestore Database → Rules → Publish.
// Enforces role-based access server-side: only the super admin can change roles,
// and nobody can self-promote past "member".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isSuper() {
      return signedIn() && myRole() == 'superadmin';
    }
    // The verified email on the auth token — the only email allowed to seed the super admin.
    function isSuperEmail() {
      return signedIn() && request.auth.token.email == 'brad.herald@safewavetech.com';
    }
    // Oversight accounts (Jared & Trevon): full read/write everywhere they can
    // reach, EXCEPT read-only on the build board and the user roster. They see
    // all tabs; the read-only enforcement lives on build_tasks/build_projects
    // (below) and on the users collection (they aren't super, so they can't
    // change anyone's role/department).
    function isOversightEmail() {
      return signedIn() && (request.auth.token.email == 'jared@safewavetech.com'
        || request.auth.token.email == 'trevon@safewavetech.com');
    }
    // Jared: informed, not deciding. He keeps read access across the company
    // (including Financials and the raise) so he knows what's going on, but has
    // no operational decision rights, so he can't create or change business
    // records. Chat, feedback, guides, his own profile and his own action items
    // stay open to him.
    function isJared() {
      return signedIn() && request.auth.token.email == 'jared@safewavetech.com';
    }
    function canOperate() {
      return signedIn() && !isJared();
    }

    // Who watched the training video (/training/), how long, which chapters.
    // Written only by the videoView Cloud Function; read by the super admin
    // and oversight on the Users screen.
    match /video_views/{id} {
      allow read: if isSuper() || isOversightEmail();
      allow write: if false;
    }

    match /users/{uid} {
      // Any signed-in teammate can read the roster (needed for the manage-team screen).
      allow read: if signedIn();

      // A user may create only their own profile, and only with role "member"
      // unless they are the verified super-admin email (which seeds "superadmin").
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == (isSuperEmail() ? 'superadmin' : 'member');

      // A user may edit their own profile (name/title/phone) but NOT their role;
      // only the super admin can change roles or edit anyone.
      allow update: if isSuper()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role);

      allow delete: if false;
    }

    // Shared CRM — every signed-in teammate can read and edit accounts
    // (the whole team sees who is reaching out to whom).
    match /crm_accounts/{id} {
      allow read: if signedIn();
      allow write: if canOperate();
    }

    // Support tickets — shared queue (email-ingested + manually added).
    match /tickets/{id} {
      allow read: if signedIn();
      allow write: if canOperate();
    }
    // The phone app's recent technical activity for a ticket's customer
    // (connects, battery, permissions, firmware update results). Written only
    // by the ticket intake function; readable by the team like tickets.
    // Support settings (e.g. pause auto-detected tickets). Super admin edits.
    // sales@ inbox connection status (non-secret: address, last check).
    // Written only by Cloud Functions; the password lives in server_keys.
    match /settings/inbox {
      allow read: if signedIn();
      allow write: if false;
    }
    match /settings/support {
      allow read: if signedIn();
      allow write: if isSuper();
    }
    match /ticket_diag/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Action items — one-off to-dos with an owner and a due date (Home →
    // Today, the daily email). Shared like tickets.
    match /actions/{id} {
      allow read: if signedIn();
      allow create, delete: if canOperate();
      // Jared can still tick off action items assigned to him.
      allow update: if canOperate() || (signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt', 'doneBy']));
    }

    // Outreach campaigns — shared so the whole team sees active sequences.
    match /campaigns/{id} {
      allow read: if signedIn();
      allow write: if canOperate();
    }

    // Build tasks + projects — shared project board (assignee, dates, status).
    // Everyone signed in can read. Oversight accounts are read-only on the
    // board's STRUCTURE, but updates/feedback and attached chats & files are
    // open to the whole team — commenting isn't editing the board.
    match /build_tasks/{id} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && !isOversightEmail();
      allow update: if signedIn() && (!isOversightEmail()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updates']));
    }
    match /build_projects/{id} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && !isOversightEmail();
      allow update: if signedIn() && (!isOversightEmail()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updates', 'attachments']));
    }

    // Inventory (locations) + order fulfillment records — shared ops.
    match /inventory/{doc} {
      allow read: if signedIn();
      allow write: if canOperate();
    }
    match /fulfillments/{id} {
      allow read: if signedIn();
      allow write: if canOperate();
    }

    // Live orders — written only by the Shopify webhook (Admin SDK); the app
    // reads them for the fulfilment queue.
    match /orders/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Purchase orders (Pace transfers / China production) — shared ops.
    match /purchase_orders/{id} {
      allow read: if signedIn();
      allow write: if canOperate();
    }
    // Customer invoices and the purchase orders customers send us (Customers →
    // Invoices & POs). Team-shared like the CRM; Jared reads only. Sent invoices
    // are voided, never deleted; only an unsent draft can be deleted.
    match /invoices/{id} {
      allow read: if signedIn();
      allow create, update: if canOperate();
      allow delete: if canOperate() && resource.data.status == 'draft';
    }
    match /customer_pos/{id} {
      allow read: if signedIn();
      allow write: if canOperate();
    }
    // Saved products picked onto invoices/POs (each line stays editable there).
    match /invoice_products/{id} {
      allow read: if signedIn();
      allow write: if canOperate();
    }
    // Next invoice number (claimed in a transaction when an invoice is created).
    match /counters/invoices {
      allow read: if signedIn();
      allow write: if canOperate();
    }

    // Per-band identity (serial + lifecycle history) and the returns queue.
    match /bands/{serial} {
      allow read: if signedIn();
      allow write: if canOperate();
    }
    match /returns/{id} {
      allow read: if signedIn();
      allow write: if canOperate();
    }

    // Team chat — channels can be public (private:false, whole team) or private
    // (members-only). Each channel is a doc with a members map; message access
    // is gated by that doc. A private channel's members are managed only by its
    // creator or an admin/super admin.
    function chatChanExists(ch) {
      return exists(/databases/$(database)/documents/chat_channels/$(ch));
    }
    function chatChan(ch) {
      return get(/databases/$(database)/documents/chat_channels/$(ch)).data;
    }
    // Legacy channels (no doc yet) are treated as public so nothing breaks
    // before the one-time migration seeds their docs.
    function chatCanAccess(ch) {
      return signedIn() && ( isSuper()
        || !chatChanExists(ch)
        || chatChan(ch).private == false
        || chatChan(ch).members[request.auth.uid] == true );
    }
    match /chat_channels/{ch} {
      // You can see a channel's metadata only if it's public or you're in it.
      allow read: if signedIn() && ( isSuper()
        || resource.data.private == false
        || resource.data.members[request.auth.uid] == true );
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // Only the owner or an admin/super admin can change it (add/remove members, rename, privacy).
      allow update: if signedIn() && ( resource.data.createdBy == request.auth.uid
        || myRole() == 'admin' || isSuper() );
      allow delete: if signedIn() && ( resource.data.createdBy == request.auth.uid || isSuper() );

      match /messages/{m} {
        allow read, write: if chatCanAccess(ch);
      }
    }
    match /settings/chat {
      allow read, write: if signedIn();
    }

    // Team feedback — any teammate can submit; only the super admin can read
    // it or change its status. A submitter may create their own entry with the
    // "open" status and cannot edit or delete it afterward.
    // Feedback: super admins read and manage all of it. Everyone else reads
    // ONLY their own submissions and may add to their own thread — never
    // anyone else's, and they can't change status or content.
    match /feedback/{id} {
      allow read: if isSuper() || (signedIn() && resource.data.fromUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isSuper()
        || (signedIn() && resource.data.fromUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thread', 'lastReplyAt']));
      allow delete: if isSuper();
    }

    // Notifications — new orders (to:'all') + task assignments (to: a uid).
    // Any teammate can create one (assigning work / order alerts); read is
    // filtered client-side to the recipient. Not editable/deletable.
    match /notifications/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Push devices — one doc per phone/browser that turned on alerts. Only the
    // signed-in owner can see or change their own; Cloud Functions send to them.
    match /push_subs/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'sub', 'ua', 'at']);
    }
    // Server-only keys (the Web Push signing key). No client may read or write.
    match /server_keys/{id} {
      allow read, write: if false;
    }

    // Overdue/needs-attention summary, written by the scanOverdue function.
    match /nudges/{id} {
      allow read: if signedIn();
      allow write: if false; // server (Admin SDK) only
    }

    // FIELD MONITOR mirror — the mirrorFieldTelemetry function copies band/app
    // telemetry here from the separate mobile-app Firebase project. It carries
    // end-user PII (which apps a wearer gets notifications from, connection
    // timing, per-user state), so read is SUPER-ADMIN ONLY. Written by the
    // Admin SDK (which bypasses rules), so client writes are denied.
    match /field_events/{id} { allow read: if isSuper(); allow write: if false; }
    match /field_users/{id}  { allow read: if isSuper(); allow write: if false; }
    match /field_bands/{id}  { allow read: if isSuper(); allow write: if false; }
    match /field_sync/{id}   { allow read: if isSuper(); allow write: if false; }

    // Per-user email credentials — readable/writable ONLY by their owner.
    // No other teammate can read them; the backend uses the Admin SDK to send.
    match /mail_credentials/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Financials — visible ONLY to the super admin and the emails on the
    // finance allow-list (settings/finance). The UI hides the tab too, but
    // this is the real enforcement.
    // Jared has stepped out of operations and has no finance decision rights:
    // he can READ Financials and the raise (see canSeeRaise) but never write,
    // even if his email is on the allow-list. Trey (trevon@) keeps full access.
    function isTrey() {
      return signedIn() && request.auth.token.email == 'trevon@safewavetech.com';
    }
    function financeOK() {
      return !isJared() && (isSuper() || isTrey() || (signedIn()
        && exists(/databases/$(database)/documents/settings/finance)
        && request.auth.token.email in get(/databases/$(database)/documents/settings/finance).data.emails));
    }
    match /finance/{doc} {
      allow read: if financeOK() || isJared();
      allow write: if financeOK();
    }
    // The allow-list itself: only the super admin can edit who has access;
    // a teammate can read it only if they are on it (or are the super admin).
    match /settings/finance {
      allow read: if isSuper() || (signedIn() && request.auth.token.email in resource.data.emails);
      allow write: if isSuper();
    }

    // Fundraise round config (target + round name). The investor pipeline itself
    // lives in crm_accounts (team-shared); this doc holds only the round total,
    // gated to leadership (admins/managers) who run the raise.
    // The raise (round config, investors, data room, cap table) is limited to
    // the finance group: Brad, Trey and the finance allow-list. Jared reads only.
    function canRaise() {
      return financeOK();
    }
    // Jared can read the raise (view-only) but never change it.
    function canSeeRaise() {
      return canRaise() || isJared();
    }
    match /settings/raise {
      allow read: if canSeeRaise();
      allow write: if canRaise();
    }
    // Investor records (moved out of the team-shared crm_accounts).
    match /investors/{id} {
      allow read: if canSeeRaise();
      allow write: if canRaise();
    }
    // Data room checklist items and their uploaded files' metadata.
    // Raise tasks Brad assigns to Trey: finance group only (titles can name investors).
    match /raise_tasks/{id} {
      allow read: if canSeeRaise();
      allow write: if canRaise();
    }
    // Raise sync meetings: agenda, minutes, decisions, action items.
    match /raise_meetings/{id} {
      allow read: if canSeeRaise();
      allow write: if canRaise();
    }
    match /dataroom/{id} {
      allow read: if canSeeRaise();
      allow write: if canRaise();
    }
    // Leadership tools (vault) keep their previous audience. Jared can read
    // and use the shared logins; only the decision group changes them.
    function canVault() {
      return signedIn() && (isOversightEmail() || myRole() == 'superadmin' || myRole() == 'admin' || myRole() == 'manager');
    }

    // Tools & passwords vault — shared team logins, gated to leadership
    // (super admin / admin / manager), same as the fundraise config. Members
    // can't read or write it. The UI hides the tab too, but this is the real
    // enforcement. Never store these in the repo — only here.
    // Guides — shared how-to docs every signed-in teammate reads, edits and
    // comments on. Each save copies the replaced text into versions/
    // (append-only), so any edit can be undone from History.
    match /guides/{id} {
      allow read, create, update: if signedIn();
      allow delete: if isSuper();
      match /versions/{v} {
        allow read, create: if signedIn();
        allow update, delete: if false;
      }
      match /comments/{c} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.byUid == request.auth.uid;
        allow update: if signedIn();
        allow delete: if isSuper() || (signedIn() && resource.data.byUid == request.auth.uid);
      }
    }

    match /vault/{id} {
      allow read: if canVault();
      allow write: if canVault() && !isJared();
    }

    // Compliance / GRC — our own SOC 2 + HIPAA control tracker, PHI map, and the
    // monthly "standard-watch" log. Admin & super admin only (the UI hides the
    // tab too, but this is the real enforcement). The scheduled standard-watch
    // job writes here via the Admin SDK, which bypasses these rules.
    function canComply() {
      return signedIn() && (isOversightEmail() || myRole() == 'superadmin' || myRole() == 'admin');
    }
    match /compliance/{id} {
      allow read: if canComply();
      allow write: if canComply() && !isJared();
    }

    // Release QC — firmware & app release records (with release notes) and the
    // soak-test / burn-in run logs that gate each release. Team-shared like the
    // build board; the UI scopes the tab to tech + leadership. QC config
    // (BLE / serial UUIDs, default thresholds) is leadership-writable.
    match /releases/{id} {
      allow read: if signedIn();
      allow write: if canOperate();
    }
    // Launches — the ship-decision records that tie one release per product
    // lane to QC evidence, sign-offs and a frozen readiness snapshot.
    match /launches/{id} {
      allow read: if signedIn();
      allow write: if canOperate();
    }
    match /qc_runs/{id} {
      allow read: if signedIn();
      allow write: if canOperate();
    }
    // Invoice letterhead: company address, payment instructions, default terms.
    // Everyone who makes invoices reads it; the finance group edits it.
    match /settings/invoicing {
      allow read: if signedIn();
      allow write: if canRaise();
    }
    match /settings/qc {
      allow read: if signedIn();
      allow write: if canRaise();
    }
    // Shopify sync status + the stock mirror (per-size "available" at the
    // shipping location). Written only by Cloud Functions.
    match /settings/shopify {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
