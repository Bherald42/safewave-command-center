rules_version = '2';
// Safewave Command Center — Firestore security rules.
// Paste these into: Firebase console → Build → Firestore Database → Rules → Publish.
// Enforces role-based access server-side: only the super admin can change roles,
// and nobody can self-promote past "member".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isSuper() {
      return signedIn() && myRole() == 'superadmin';
    }
    // The verified email on the auth token — the only email allowed to seed the super admin.
    function isSuperEmail() {
      return signedIn() && request.auth.token.email == 'brad.herald@safewavetech.com';
    }

    match /users/{uid} {
      // Any signed-in teammate can read the roster (needed for the manage-team screen).
      allow read: if signedIn();

      // A user may create only their own profile, and only with role "member"
      // unless they are the verified super-admin email (which seeds "superadmin").
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == (isSuperEmail() ? 'superadmin' : 'member');

      // A user may edit their own profile (name/title/phone) but NOT their role;
      // only the super admin can change roles or edit anyone.
      allow update: if isSuper()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role);

      allow delete: if false;
    }

    // Shared CRM — every signed-in teammate can read and edit accounts
    // (the whole team sees who is reaching out to whom).
    match /crm_accounts/{id} {
      allow read, write: if signedIn();
    }

    // Support tickets — shared queue (email-ingested + manually added).
    match /tickets/{id} {
      allow read, write: if signedIn();
    }

    // Outreach campaigns — shared so the whole team sees active sequences.
    match /campaigns/{id} {
      allow read, write: if signedIn();
    }

    // Build tasks — shared project board (assignee + due date).
    match /build_tasks/{id} {
      allow read, write: if signedIn();
    }

    // Team chat — channels + messages, shared across signed-in teammates.
    match /chat_channels/{ch}/messages/{m} {
      allow read, write: if signedIn();
    }
    match /settings/chat {
      allow read, write: if signedIn();
    }

    // Overdue/needs-attention summary, written by the scanOverdue function.
    match /nudges/{id} {
      allow read: if signedIn();
      allow write: if false; // server (Admin SDK) only
    }

    // Per-user email credentials — readable/writable ONLY by their owner.
    // No other teammate can read them; the backend uses the Admin SDK to send.
    match /mail_credentials/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Financials — visible ONLY to the super admin and the emails on the
    // finance allow-list (settings/finance). The UI hides the tab too, but
    // this is the real enforcement.
    function financeOK() {
      return isSuper() || (signedIn()
        && exists(/databases/$(database)/documents/settings/finance)
        && request.auth.token.email in get(/databases/$(database)/documents/settings/finance).data.emails);
    }
    match /finance/{doc} {
      allow read, write: if financeOK();
    }
    // The allow-list itself: only the super admin can edit who has access;
    // a teammate can read it only if they are on it (or are the super admin).
    match /settings/finance {
      allow read: if isSuper() || (signedIn() && request.auth.token.email in resource.data.emails);
      allow write: if isSuper();
    }
  }
}
