rules_version = '2';
// Safewave Command Center — Firestore security rules.
// Paste these into: Firebase console → Build → Firestore Database → Rules → Publish.
// Enforces role-based access server-side: only the super admin can change roles,
// and nobody can self-promote past "member".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isSuper() {
      return signedIn() && myRole() == 'superadmin';
    }
    // The verified email on the auth token — the only email allowed to seed the super admin.
    function isSuperEmail() {
      return signedIn() && request.auth.token.email == 'brad.herald@safewavetech.com';
    }
    // Oversight accounts (Jared & Trevon): full read/write everywhere they can
    // reach, EXCEPT read-only on the build board and the user roster. They see
    // all tabs; the read-only enforcement lives on build_tasks/build_projects
    // (below) and on the users collection (they aren't super, so they can't
    // change anyone's role/department).
    function isOversightEmail() {
      return signedIn() && (request.auth.token.email == 'jared@safewavetech.com'
        || request.auth.token.email == 'trevon@safewavetech.com');
    }

    match /users/{uid} {
      // Any signed-in teammate can read the roster (needed for the manage-team screen).
      allow read: if signedIn();

      // A user may create only their own profile, and only with role "member"
      // unless they are the verified super-admin email (which seeds "superadmin").
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == (isSuperEmail() ? 'superadmin' : 'member');

      // A user may edit their own profile (name/title/phone) but NOT their role;
      // only the super admin can change roles or edit anyone.
      allow update: if isSuper()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role);

      allow delete: if false;
    }

    // Shared CRM — every signed-in teammate can read and edit accounts
    // (the whole team sees who is reaching out to whom).
    match /crm_accounts/{id} {
      allow read, write: if signedIn();
    }

    // Support tickets — shared queue (email-ingested + manually added).
    match /tickets/{id} {
      allow read, write: if signedIn();
    }

    // Outreach campaigns — shared so the whole team sees active sequences.
    match /campaigns/{id} {
      allow read, write: if signedIn();
    }

    // Build tasks + projects — shared project board (assignee, dates, status).
    // Everyone signed in can read; oversight accounts are read-only here.
    match /build_tasks/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && !isOversightEmail();
    }
    match /build_projects/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && !isOversightEmail();
    }

    // Inventory (locations) + order fulfillment records — shared ops.
    match /inventory/{doc} {
      allow read, write: if signedIn();
    }
    match /fulfillments/{id} {
      allow read, write: if signedIn();
    }

    // Live orders — written only by the Shopify webhook (Admin SDK); the app
    // reads them for the fulfilment queue.
    match /orders/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Purchase orders (Pace transfers / China production) — shared ops.
    match /purchase_orders/{id} {
      allow read, write: if signedIn();
    }

    // Per-band identity (serial + lifecycle history) and the returns queue.
    match /bands/{serial} {
      allow read, write: if signedIn();
    }
    match /returns/{id} {
      allow read, write: if signedIn();
    }

    // Team chat — channels can be public (private:false, whole team) or private
    // (members-only). Each channel is a doc with a members map; message access
    // is gated by that doc. A private channel's members are managed only by its
    // creator or an admin/super admin.
    function chatChanExists(ch) {
      return exists(/databases/$(database)/documents/chat_channels/$(ch));
    }
    function chatChan(ch) {
      return get(/databases/$(database)/documents/chat_channels/$(ch)).data;
    }
    // Legacy channels (no doc yet) are treated as public so nothing breaks
    // before the one-time migration seeds their docs.
    function chatCanAccess(ch) {
      return signedIn() && ( isSuper()
        || !chatChanExists(ch)
        || chatChan(ch).private == false
        || chatChan(ch).members[request.auth.uid] == true );
    }
    match /chat_channels/{ch} {
      // You can see a channel's metadata only if it's public or you're in it.
      allow read: if signedIn() && ( isSuper()
        || resource.data.private == false
        || resource.data.members[request.auth.uid] == true );
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // Only the owner or an admin/super admin can change it (add/remove members, rename, privacy).
      allow update: if signedIn() && ( resource.data.createdBy == request.auth.uid
        || myRole() == 'admin' || isSuper() );
      allow delete: if signedIn() && ( resource.data.createdBy == request.auth.uid || isSuper() );

      match /messages/{m} {
        allow read, write: if chatCanAccess(ch);
      }
    }
    match /settings/chat {
      allow read, write: if signedIn();
    }

    // Team feedback — any teammate can submit; only the super admin can read
    // it or change its status. A submitter may create their own entry with the
    // "open" status and cannot edit or delete it afterward.
    match /feedback/{id} {
      allow read: if isSuper();
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update, delete: if isSuper();
    }

    // Notifications — new orders (to:'all') + task assignments (to: a uid).
    // Any teammate can create one (assigning work / order alerts); read is
    // filtered client-side to the recipient. Not editable/deletable.
    match /notifications/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Overdue/needs-attention summary, written by the scanOverdue function.
    match /nudges/{id} {
      allow read: if signedIn();
      allow write: if false; // server (Admin SDK) only
    }

    // Per-user email credentials — readable/writable ONLY by their owner.
    // No other teammate can read them; the backend uses the Admin SDK to send.
    match /mail_credentials/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Financials — visible ONLY to the super admin and the emails on the
    // finance allow-list (settings/finance). The UI hides the tab too, but
    // this is the real enforcement.
    function financeOK() {
      return isSuper() || isOversightEmail() || (signedIn()
        && exists(/databases/$(database)/documents/settings/finance)
        && request.auth.token.email in get(/databases/$(database)/documents/settings/finance).data.emails);
    }
    match /finance/{doc} {
      allow read, write: if financeOK();
    }
    // The allow-list itself: only the super admin can edit who has access;
    // a teammate can read it only if they are on it (or are the super admin).
    match /settings/finance {
      allow read: if isSuper() || (signedIn() && request.auth.token.email in resource.data.emails);
      allow write: if isSuper();
    }

    // Fundraise round config (target + round name). The investor pipeline itself
    // lives in crm_accounts (team-shared); this doc holds only the round total,
    // gated to leadership (admins/managers) who run the raise.
    function canRaise() {
      return signedIn() && (isOversightEmail() || myRole() == 'superadmin' || myRole() == 'admin' || myRole() == 'manager');
    }
    match /settings/raise {
      allow read, write: if canRaise();
    }

    // Tools & passwords vault — shared team logins, gated to leadership
    // (super admin / admin / manager), same as the fundraise config. Members
    // can't read or write it. The UI hides the tab too, but this is the real
    // enforcement. Never store these in the repo — only here.
    match /vault/{id} {
      allow read, write: if canRaise();
    }

    // Compliance / GRC — our own SOC 2 + HIPAA control tracker, PHI map, and the
    // monthly "standard-watch" log. Admin & super admin only (the UI hides the
    // tab too, but this is the real enforcement). The scheduled standard-watch
    // job writes here via the Admin SDK, which bypasses these rules.
    function canComply() {
      return signedIn() && (isOversightEmail() || myRole() == 'superadmin' || myRole() == 'admin');
    }
    match /compliance/{id} {
      allow read, write: if canComply();
    }

    // Release QC — firmware & app release records (with release notes) and the
    // soak-test / burn-in run logs that gate each release. Team-shared like the
    // build board; the UI scopes the tab to tech + leadership. QC config
    // (BLE / serial UUIDs, default thresholds) is leadership-writable.
    match /releases/{id} {
      allow read, write: if signedIn();
    }
    match /qc_runs/{id} {
      allow read, write: if signedIn();
    }
    match /settings/qc {
      allow read: if signedIn();
      allow write: if canRaise();
    }
  }
}
